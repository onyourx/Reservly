{% comment %}
  Bagsy storefront booking widget.

  Shopify still owns checkout: the hidden form and its _booking_* line-item
  properties are populated by booking-widget.js after the modal flow completes.
{% endcomment %}

{% assign btype = product.metafields.booking.type %}
{% assign bno = product.metafields.booking.product_no %}

{% if btype == 'RENTAL' or btype == 'COURSE' or btype == 'SERVICE' %}
  <div
    class="gsl-booking"
    data-type="{{ btype }}"
    data-product-no="{{ bno | escape }}"
    data-product-title="{{ product.title | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-proxy="/apps/booking"
    data-i18n-fulfillment="{{ 'booking_widget.gsl_fulfillment_title' | t | escape }}"
    data-i18n-pickup="{{ 'booking_widget.gsl_fulfillment_pickup' | t | escape }}"
    data-i18n-ship="{{ 'booking_widget.gsl_fulfillment_ship' | t | escape }}"
    data-i18n-address="{{ 'booking_widget.gsl_shipping_address' | t | escape }}"
    data-i18n-shipping-fee="{{ 'booking_widget.gsl_shipping_fee' | t | escape }}"
  >
    {%- if btype == 'RENTAL' and product.metafields.booking.price_per_day -%}
      <div class="gsl-rates">
        <span class="gsl-rate">{{ product.metafields.booking.price_per_day.value | times: 100 | round | money }} {{ 'booking_widget.gsl_per_day' | t }}</span>
        {%- if product.metafields.booking.price_per_week -%}
          <span class="gsl-rate-sep">·</span>
          <span class="gsl-rate">{{ product.metafields.booking.price_per_week.value | times: 100 | round | money }} {{ 'booking_widget.gsl_per_week' | t }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    <button type="button" class="gsl-launch">
      {% case btype %}
        {% when 'RENTAL' %}Check availability
        {% when 'COURSE' %}Select a time
        {% else %}Book now
      {% endcase %}
    </button>

    <div class="gsl-modal" hidden>
      <div class="gsl-backdrop" data-gsl-close></div>
      <section
        class="gsl-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="gsl-modal-title"
        tabindex="-1"
      >
        <header class="gsl-modal-head">
          <div>
            <h2 id="gsl-modal-title">{{ product.title | escape }}</h2>
            <p class="gsl-timezone"></p>
          </div>
          <button type="button" class="gsl-close" data-gsl-close aria-label="Close booking dialog">&times;</button>
        </header>
        <div class="gsl-progress" aria-live="polite"></div>
        <div class="gsl-modal-body"></div>
        <footer class="gsl-modal-foot">
          <button type="button" class="gsl-secondary gsl-back" hidden>Back</button>
          <button type="button" class="gsl-primary gsl-next" disabled>Next</button>
        </footer>
      </section>
    </div>

    <form method="post" action="{{ routes.cart_add_url }}" class="gsl-add-form" hidden>
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1" class="gsl-qty">
      <input type="hidden" name="properties[_booking_type]" value="{{ btype }}">
      <input type="hidden" name="properties[_product_no]" value="{{ bno | escape }}">
      <input type="hidden" name="properties[_store_id]" class="gsl-p-store">
      <input type="hidden" name="properties[_from]" class="gsl-p-from">
      <input type="hidden" name="properties[_to]" class="gsl-p-to">
      <input type="hidden" name="properties[_session_id]" class="gsl-p-session">
      <input type="hidden" name="properties[_hold_token]" class="gsl-p-hold">
      <input type="hidden" name="properties[_terms_accepted]" class="gsl-p-terms" value="false">
      <input type="hidden" name="properties[_fulfillment]" class="gsl-p-fulfillment" value="PICKUP">
      <input type="hidden" name="properties[_ship_address]" class="gsl-p-ship-address">
      <input type="hidden" name="properties[Booking]" class="gsl-p-label">
    </form>
  </div>

  {{ 'booking-widget.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'booking-widget.js' | asset_url }}" defer></script>
{% elsif request.design_mode %}
  <div style="padding:14px;border:1px dashed #bbb;border-radius:8px;color:#666;font-size:14px;">
    Booking widget: this product has no supported <code>booking.type</code> metafield.
    Publish a rental, course, or service from Booking Desk to show the booking button.
  </div>
{% endif %}

{% schema %}
{
  "name": "Booking widget",
  "target": "section",
  "settings": []
}
{% endschema %}
